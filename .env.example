# PlanGram Environment Configuration

# Data Mode
# Options: prototype, uploaded, official
DATA_MODE=prototype

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/plangram

# AI Provider Configuration
# Options: gemini, openai, none
AI_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6K0twh1Zx5HZKUCum8ATX96iYn-cDSXG6D4AiJBsVEt8w
OPENAI_API_KEY=your_openai_api_key_here

# AI Settings
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload Settings
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads

# GIS Settings
INTERNAL_CRS=EPSG:4326
DISTANCE_THRESHOLD_METERS=500

# Optimization
OPTIMIZATION_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO
